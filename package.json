{
  "name": "ban-tin-sang",
  "private": true,
  "version": "0.1.0",
  "description": "Bản tin đọc mỗi sáng: tin nóng mạng xã hội, drama, thế giới, trong nước, giá vàng, giá xăng",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -b && vite build --mode extension",
    "build:static": "tsc -b && vite build --mode static",
    "publish:brief": "node scripts/publish-brief.ts dist-static",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
